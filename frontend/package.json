{
  "name": "openartifact",
  "version": "0.1.0",
  "private": true,
  "description": "The OpenArtifact browser runtime (openartifact.js) and the web app for listing and editing artifacts.",
  "type": "module",
  "license": "MIT",
  "author": "Samuel Colvin <s@muelcolvin.com>",
  "homepage": "https://github.com/samuelcolvin/openartifact#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelcolvin/openartifact.git"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "pnpm build:runtime && pnpm build:app",
    "build:runtime": "esbuild src/main.ts --bundle --format=iife --target=es2022 --loader:.css=text --minify --outfile=dist/openartifact.js",
    "build:app": "vite build",
    "dev": "esbuild src/main.ts --bundle --format=iife --target=es2022 --loader:.css=text --outfile=dist/openartifact.js --watch",
    "app:dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "lint": "biome check .",
    "format": "biome check --fix ."
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.133",
    "ai": "^7.0.130",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.52.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
